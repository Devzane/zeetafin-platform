# Phase 3 Production Environment Configuration Template
# Copy this file to .env on the EC2 host: cp .env.example .env

# Amazon ECR Registry Configuration
# Format: <aws-account-id>.dkr.ecr.<aws-region>.amazonaws.com
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=latest

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=zeetafin_secure_production_password_2026!
POSTGRES_DB=zeetafin

# Backend Application Configuration (NestJS)
JWT_SECRET=production_enterprise_super_secret_jwt_key_zeetafin_2026
NODE_ENV=production
DB_SYNC=true
DB_LOGGING=false

# Frontend Application Configuration (Next.js)
# Set this to your EC2 public IP or public DNS: http://<EC2_PUBLIC_IP>:3001/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
